# === 8. SPITTOON: nav depth signal -> ballast pumps through a box that can blow the tanks on command ===
unwire 24.velocity_y_out 39.set_targetlevel
unwire 24.velocity_y_out 99.set_targetlevel
box @spit at 900,100 from camel/camel_ballast
wire 24.velocity_y_out @spit.signal_in1
wire @spit.signal_out1 39.set_targetlevel
wire @spit.signal_out1 99.set_targetlevel

# === 9. WEAPONS: the empty hardpoint becomes a second chaingun with its own periscope, loader and supercapacitor ===
remove 25
remove 26
remove 28
add @gun2 chaingun at -1320,377
add @per2 periscope at 1387,214
add @ldr2 chaingunloader at 1353,181
set @gun2 linked=@ldr2
set @ldr2 linked=@gun2
add @cap2 supercapacitor at 1040,80
wire 477.power_out @cap2.power_in
wire 531.power_out @cap2.power_in
wire @cap2.power_out @gun2.power_in
wire @per2.position_out @gun2.position_in
wire @per2.trigger_out @gun2.trigger_in

