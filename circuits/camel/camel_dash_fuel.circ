# CAMEL OVERKILL: DASH-2 "FUEL WALL". Rods, fuel, time left, energy made and efficiency, worked out from the
# game's own fuel math (reference/BAROTRAUMA_MECHANICS.md 1.2-1.3). Short values next to fixed captions, like DASH-1.
name camel_dash_fuel
box battery
note "DASH-2 FUEL WALL: HOW IT WORKS" "Game facts: fuel_out = 80 per live uranium rod, fuel_percentage_left = sum of rod condition %, and every rod loses fission% x 0.2 / 100 condition per second.\nout1 RODS: fuel_out / 80, rounded.\nout2 FUEL: fuel_percentage_left, rounded, + '%'.\nout3 RUNTIME '4h 12m': average rod % / (fission x 0.002) seconds, split into hours and minutes.\nout4 ENERGY '123 kWh' this round: power / 216000 added every tick (60 ticks/s, 3600 s/h).\nout5 kWh/ROD: energy made / rods burned (rods x fission x 0.002 / 100 / 60 added every tick).\nEvery value fits its display, so none of them scrolls."
note "WIRING" "in1 <- reactor fuel_out, in2 <- reactor fuel_percentage_left, in3 <- HUMP-1 out1 (fission), in4 <- reactor power_value_out\nout1..out5 -> value displays (set_text)"
c k80 mem Value=80
c rd div
c rods round ClampMin=0
w in1 rd.1
w k80.out rd.2
w rd.out rods.in
w rods.out out1
c fpr round
c pc mem Value=%
c a3 concat
w in2 fpr.in
w fpr.out a3.1
w pc.out a3.2
w a3.out out2
# time left
c avg div
c k002 mem Value=0.002
c eps mem Value=0.0001
c rate0 mul
c rate add
c tl div ClampMin=0 ClampMax=359999
w in2 avg.1
w rods.out avg.2
w in3 rate0.1
w k002.out rate0.2
w rate0.out rate.1
w eps.out rate.2
w avg.out tl.1
w rate.out tl.2
c k3600 mem Value=3600
c k60 mem Value=60
c hh0 div
c hh floor
c mm0 mod Modulus=3600
c mm1 div
c mm floor
w tl.out hh0.1 mm0.in
w k3600.out hh0.2
w hh0.out hh.in
w mm0.out mm1.1
w k60.out mm1.2
w mm1.out mm.in
c uh mem Value=h
c um mem Value=m
c b1 concat
c b2 concat Separator=" "
c b3 concat
w hh.out b1.1
w uh.out b1.2
w b1.out b2.1
w mm.out b2.2
w b2.out b3.1
w um.out b3.2
w b3.out out3
# rods x fission, for the rods burned below
c br0 mul
w rods.out br0.1
w in3 br0.2
# energy made this round (kWh), integrated every tick
c kwt mem Value=0.00000463   # 1 / 216000
c e0 mul
c en mem Value=0
c ea add
w in4 e0.1
w kwt.out e0.2
w en.out ea.1
w e0.out ea.2
w ea.out en.in
c er round
c t4 mem Value=kWh
c d2 concat Separator=" "
w en.out er.in
w er.out d2.1
w t4.out d2.2
w d2.out out4
# rods burned this round, integrated every tick: rods x fission x 0.002 / 100 / 60 = rods x fission x 0.000000333
c krb mem Value=0.000000333
c rb0 mul
c rbm mem Value=0
c rba add
w br0.out rb0.1
w krb.out rb0.2
w rbm.out rba.1
w rb0.out rba.2
w rba.out rbm.in
c eff div ClampMax=99999
c efr round
w en.out eff.1
w rbm.out eff.2
w eff.out efr.in
w efr.out out5
