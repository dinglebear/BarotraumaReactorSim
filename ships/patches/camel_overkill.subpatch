# GENERATED by ships/patches/camel_overkill.gen.js - edit the generator, not this file.
subname Camel Overkill
subattr description Hi, I'm Claude, an AI made by Anthropic, and this is MY camel. Dinglebear handed me the vanilla Camel and said "go crazy", so I tore out every wire and rebuilt every system myself. It has my own auto reactor (switch the reactor's automatic control OFF at round start so it can take over), a power manager that keeps the engine from ever stalling the grid, air, flood and fire sensors in every room, doors that seal themselves when a room floods, a screen wall that tells you how long your fuel will last, and CamelOS at the bridge terminal (type "help", or say "camel status" on radio channel 0). 38 circuit boxes, 6 batteries, one camel with feelings. Some commands aren't in the help. One room doesn't like visitors. It's mine. Stay out. Tested by Dinglebear. The Camel itself is FakeFish's; I just made it worse, in the best way.

# === 1. PROPULSION BUS: 4 new batteries feed ONLY the engine and the ballast pumps (HUMP-P keeps them near 80 %) ===
add @pb1 battery at -1080,79.5 PowerContainer.Charge=1600 PowerContainer.RechargeSpeed=250
add @pb2 battery at -1015,79.5 PowerContainer.Charge=1600 PowerContainer.RechargeSpeed=250
add @pb3 battery at -950,79.5 PowerContainer.Charge=1600 PowerContainer.RechargeSpeed=250
add @pb4 battery at -885,79.5 PowerContainer.Charge=1600 PowerContainer.RechargeSpeed=250
add @pjb1 junctionbox at -820,84
add @pjb2 junctionbox at -765,84
add @cjb junctionbox at -820,200   # charge bus: main grid -> propulsion batteries
unwire 112.power 3.power_in
unwire 113.power 39.power_in
unwire 113.power 99.power_in
wire @pb1.power_out @pjb1.power
wire @pb2.power_out @pjb1.power
wire @pb3.power_out @pjb1.power
wire @pb4.power_out @pjb1.power
wire @pjb1.power @pjb2.power
wire @pjb2.power 3.power_in
wire @pjb2.power 39.power_in
wire @pjb2.power 99.power_in
add @tap relaycomponent at -870,200 RelayComponent.MaxPower=4000   # CHARGE TAP: all battery charging flows through it; its load_value_out measures it
wire 112.power @tap.power_in
wire @tap.power_out @cjb.power
add @cjb2 junctionbox at 560,-140   # critical bank now charges through the tap too
wire @cjb.power @cjb2.power
unwire 55.power 477.power_in
unwire 55.power 531.power_in
wire @cjb2.power 477.power_in
wire @cjb2.power 531.power_in
wire @cjb.power @pb1.power_in
wire @cjb.power @pb2.power_in
wire @cjb.power @pb3.power_in
wire @cjb.power @pb4.power_in
box @humpP at -950,230 from camel/camel_propulsion
wire @pb1.charge_% @humpP.signal_in1
wire @pb1.load_value_out @humpP.signal_in2
wire @tap.load_value_out @humpP.signal_in4
wire 477.charge_% @humpP.signal_in5
box @humpR at -1010,230 from camel/camel_rates   # HUMP-P part 2: a circuit box holds at most 64 parts
wire @humpP.signal_out1 @humpR.signal_in1
wire @humpP.signal_out5 @humpR.signal_in2
wire @humpR.signal_out4 477.set_rate
wire @humpR.signal_out8 531.set_rate
wire @humpR.signal_out1 @pb1.set_rate
wire @humpP.signal_out3 @pb1.disable_output
wire @humpR.signal_out5 @pb2.set_rate
wire @humpP.signal_out3 @pb2.disable_output
wire @humpR.signal_out6 @pb3.set_rate
wire @humpP.signal_out3 @pb3.disable_output
wire @humpR.signal_out7 @pb4.set_rate
wire @humpP.signal_out3 @pb4.disable_output

# === 2. HUMP-1 REACTOR BRAIN: feed-forward control of the main bus (turn the reactor's automatic control OFF in game) ===
box @hump1 at -880,-30 from camel/camel_reactor
wire 787.load_value_out @hump1.signal_in1
wire 787.power_value_out @hump1.signal_in2
wire 787.temperature_out @hump1.signal_in3
wire 787.fuel_out @hump1.signal_in4
wire @hump1.signal_out1 787.set_fissionrate
wire @hump1.signal_out2 787.set_turbineoutput
wire 787.load_value_out @humpP.signal_in3
wire 787.power_value_out @humpP.signal_in6
wire @humpP.signal_out2 @hump1.signal_in8

# === 2b. SCREEN WALL: 14 text displays fed by three dashboard boxes (reactor, fuel, ship) ===
box @dashR at -1400,-40 from camel/camel_dash_reactor
