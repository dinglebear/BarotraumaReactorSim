# === 3. HUMP-2 GOVERNOR: oxygen generator on a relay (85 %..97 % hysteresis) + load shedding ===
add @o2a oxygendetector at 760,240      # bridge
add @o2b oxygendetector at 0,-240       # crew quarters
add @rO2 relaycomponent at 820,20 RelayComponent.MaxPower=2000   # headroom: the generator alone draws exactly the stock 1000 kW limit
unwire 54.power 1040.power_in
wire 54.power @rO2.power_in
wire @rO2.power_out 1040.power_in
add @rFab relaycomponent at -380,-290 RelayComponent.MaxPower=2000
unwire 53.power 36.power_in
unwire 53.power 35.power_in
wire 53.power @rFab.power_in
wire @rFab.power_out 36.power_in
wire @rFab.power_out 35.power_in
box @hump2 at 770,20 from camel/camel_governor
wire @o2a.signal_out @hump2.signal_in1
wire @o2b.signal_out @hump2.signal_in2
wire @pb1.charge_% @hump2.signal_in3
wire @hump2.signal_out1 @rO2.set_state
wire @hump2.signal_out2 @rFab.set_state
wire @hump2.signal_out2 610.set_state
wire @hump2.signal_out2 611.set_state

