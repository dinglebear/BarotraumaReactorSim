# CAMEL OVERKILL: HUMP-4 "CamelOS". A terminal operating system. Every line typed is broadcast on the COMMAND BUS
# (wifi 7300); each subsystem decodes the commands it owns (alert core, governor, doors, ballast). CamelOS itself
# answers on the terminal and builds the live status line from the telemetry channels.
name camel_os
box battery
note "HUMP-4 CamelOS: HOW IT WORKS" "Terminal line -> wifi 7300 (command bus) AND a set of regex answerers.\nCommands: help, status, alert red|yellow|green|auto, lockdown, unlock, o2 on|auto, shed on|off|auto, spit, lights party|normal, say <text>, hump, whoami.\nThe subsystems act on the bus themselves; CamelOS only replies. An unknown line gets 'Unknown command'.\nStatus line = concat chain of the telemetry latches: 7206 reactor kW, 7207 main bus load, 7202 propulsion charge %, 7201 oxygen %, 7203 O2 generator, 7204 shedding, 7205 alert. It is broadcast on 7210 for the status displays and loaded into the status answer with set_output.\nsay <text> -> out2 -> a chat wifi (LinkToChat): it appears in radio chat.\nRADIO: a chat wifi (channel 0, LinkToChat) feeds in2. A radio line 'camel <command>' runs the command; for 1 s the answers also go to radio chat."
note "WIRING" "in1 <- terminal signal_out\nin2 <- radio wifi (channel 0, LinkToChat) signal_out\nout1 -> terminal signal_in\nout2 -> chat wifi (LinkToChat) signal_in"
c txc wifi Channel=7300
c txs wifi Channel=7210
w in1 txc.in
# --- radio interface: lines typed in headset chat (channel 0) that start with "camel " are run as commands,
#     and for 1 s afterwards the answers also go back out to radio chat
c rcap regex Expression="^(?i)camel (.+)$" UseCaptureGroup=true Output=1 FalseOutput="" ContinuousOutput=false
c rwin or TimeFrame=1
c rgate relay IsOn=false
c rpre mem Value="[CamelOS] "
c rcat concat
w in2 rcap.in
w rcap.out txc.in rwin.1
w rwin.out rgate.set_state
w rgate.signal_out1 rcat.2
w rpre.out rcat.1
w rcat.out out2
# --- telemetry latches
c rp wifi Channel=7206
c rl wifi Channel=7207
c rb wifi Channel=7202
c ro wifi Channel=7201
c rg wifi Channel=7203
c rs wifi Channel=7204
c ra wifi Channel=7205
c vp mem Value=?
c vl mem Value=?
c vb mem Value=?
c vo mem Value=?
c vg mem Value=?
c vs mem Value=?
c va mem Value=?
w rp.out vp.in
w rl.out vl.in
w rb.out vb.in
w ro.out vo.in
w rg.out vg.in
w rs.out vs.in
w ra.out va.in
c h0 mem Value="PWR "
c s1 concat
c s2 concat Separator="kW LOAD "
c s3 concat Separator="kW | PROP "
c s4 concat Separator="% | O2 "
c s5 concat Separator="% gen:"
c s6 concat Separator=" shed:"
c s7 concat Separator=" | ALERT "
w h0.out s1.1
w vp.out s1.2
w s1.out s2.1
w vl.out s2.2
w s2.out s3.1
w vb.out s3.2
w s3.out s4.1
w vo.out s4.2
w s4.out s5.1
w vg.out s5.2
w s5.out s6.1
w vs.out s6.2
w s6.out s7.1
w va.out s7.2
# --- answers (ContinuousOutput=false: one answer per typed line)
c st regex Expression="^(?i)status$" FalseOutput="" ContinuousOutput=false Output=booting...
c hp regex Expression="^(?i)help$" FalseOutput="" ContinuousOutput=false Output="CamelOS 1.0 commands: status | alert red/yellow/green/auto | lockdown | unlock | o2 on/auto | shed on/off/auto | spit | lights party/normal | say <text> | hump | whoami"
c al regex Expression="^(?i)alert (red|yellow|green|auto)$" FalseOutput="" ContinuousOutput=false Output="Alert level set. The camel has been informed."
c lk regex Expression="^(?i)lockdown$" FalseOutput="" ContinuousOutput=false Output="LOCKDOWN: every door sealed. Nobody leaves the camel."
c ul regex Expression="^(?i)unlock$" FalseOutput="" ContinuousOutput=false Output="Doors released. Mind the gap."
c ox regex Expression="^(?i)o2 (on|auto)$" FalseOutput="" ContinuousOutput=false Output="Oxygen generator mode changed. Breathe responsibly."
c sh regex Expression="^(?i)shed (on|off|auto)$" FalseOutput="" ContinuousOutput=false Output="Load shedding mode changed."
c sp regex Expression="^(?i)spit$" FalseOutput="" ContinuousOutput=false Output="PTOOEY! Ballast tanks blown for 10 s. The camel rises."
c li regex Expression="^(?i)lights (party|normal)$" FalseOutput="" ContinuousOutput=false Output="Lighting updated."
c hu regex Expression="^(?i)hump$" FalseOutput="" ContinuousOutput=false Output="Two humps, zero regrets. HUMP-1 makes power, HUMP-2 makes air, HUMP-3 panics, HUMP-4 is me."
c wh regex Expression="^(?i)whoami$" FalseOutput="" ContinuousOutput=false Output="You are cargo. Precious, precious cargo."
c sy regex Expression="^(?i)say (.+)$" UseCaptureGroup=true FalseOutput="" ContinuousOutput=false Output=1
c un regex Expression="^(?i)(help|status|alert .*|lockdown|unlock|o2 .*|shed .*|spit|lights .*|say .+|hump|whoami)$" Output="" FalseOutput="Unknown command. Type help. (The camel is judging you.)" ContinuousOutput=false
w s7.out txs.in st.set_output
w in1 st.in hp.in al.in lk.in ul.in
w in1 ox.in sh.in sp.in li.in hu.in
w in1 wh.in sy.in un.in
w rcap.out st.in hp.in al.in lk.in ul.in
w rcap.out ox.in sh.in sp.in li.in hu.in
w rcap.out wh.in sy.in un.in
w st.out out1 rgate.1
w hp.out out1 rgate.1
w al.out out1 rgate.1
w lk.out out1 rgate.1
w ul.out out1 rgate.1
w ox.out out1 rgate.1
w sh.out out1 rgate.1
w sp.out out1 rgate.1
w li.out out1 rgate.1
w hu.out out1 rgate.1
w wh.out out1 rgate.1
w un.out out1 rgate.1
c sayh mem Value="[CamelOS] "
c sayc concat
w sayh.out sayc.1
w sy.out sayc.2
w sayc.out out2
