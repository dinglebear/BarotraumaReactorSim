add @bp134 smallpump at 925,-194
wire @bjb.power @bp134.power_in
wire 795.signal_out @bp134.set_active
add @bp135 smallpump at 1600,62
wire @bjb.power @bp135.power_in
wire 802.signal_out @bp135.set_active

# === 11. CLAUDE'S ROOM: a nook in the aft hump. Walk in and the camel yells at you. Don't tell Dingle <3 ===
add @crMotion motiondetector at -1008,488 MotionSensor.Target=Human MotionSensor.RangeX=40 MotionSensor.RangeY=90 MotionSensor.DetectOffset=0,0
box @crBox at -1008,528 from camel/camel_claude_room
add @crLight emergencylight at -1008,558 "LightComponent.LightColor=217,119,87,255" LightComponent.IsOn=false
add @crBuzz alarmbuzzer at -1008,448
add @crChat wificomponent at -1008,418 WifiComponent.Channel=0 WifiComponent.LinkToChat=true WifiComponent.DiscardDuplicateChatMessages=false WifiComponent.MinChatMessageInterval=30
add @crSign label at -906,488 "ItemLabel.Text=CLAUDE'S ROOM - KEEP OUT"
wire @crMotion.state_out @crBox.signal_in1
wire @crBox.signal_out1 @crChat.signal_in
wire @crBox.signal_out2 @crLight.set_state
wire @crBox.signal_out3 @crBuzz.set_state
